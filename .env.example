# Ollama HTTP API (default: local install)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Models — pull with: ollama pull <name>
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Where Cluny stores SQLite + Chroma.
# Relative paths resolve next to pyproject.toml; use an absolute path for a fixed folder e.g. ~/cluny
CLUNY_DATA_DIR=.cluny

# Catalog folder under CLUNY_DATA_DIR (default: library). Use BRAIN, etc.
# CLUNY_CATALOG_DIR=library

# SQLite filename inside that folder (default: library.sqlite). Example with BRAIN folder:
# CLUNY_LIBRARY_SQLITE=brain.sqlite

# PDF text layer vs OCR: auto (try text, then OCR if empty) | always | never
# Requires Tesseract on PATH (e.g. brew install tesseract) plus pymupdf/pytesseract/Pillow.
CLUNY_PDF_OCR=auto

# URL fetching (cluny add-url)
# open = allow all hosts except blocklist | restricted = only CLUNY_URL_ALLOWLIST
CLUNY_URL_MODE=open
# Comma-separated host patterns (e.g. example.com,*.edu)
# CLUNY_URL_ALLOWLIST=
# CLUNY_URL_BLOCKLIST=facebook.com,doubleclick.net
CLUNY_URL_MAX_BYTES=15000000
CLUNY_URL_TIMEOUT_SEC=30
# CLUNY_URL_USER_AGENT=Cluny/0.1

# Default folder for `cluny watch` when no path is passed (optional).
# CLUNY_WATCH_PATH=/Users/you/notes

# Kosistenz journal folder — auto-index when using `cluny watch-kosistenz-journal`
# or as fallback for `cluny watch` when CLUNY_WATCH_PATH is unset.
# CLUNY_KOSISTENZ_JOURNAL_DIR=/Users/you/Library/Application Support/Kosistenz/Journal

# Optional: route widget/GUI chat+capture through cluny serve (same as Kosistenz uses)
# CLUNY_BRAIN_URL=http://127.0.0.1:8787
# CLUNY_API_TOKEN=

# Hybrid retrieval (vector + SQLite FTS5)
CLUNY_HYBRID_VECTOR_WEIGHT=0.5
CLUNY_RETRIEVAL_K=20

# Ollama client resilience
# OLLAMA_TIMEOUT_SEC=120
# OLLAMA_RETRIES=2

# Batch embedding during ingest
CLUNY_EMBED_BATCH_SIZE=8

# Optional LLM rerank: off | llm | cross (cross needs pip install -e '.[rerank]')
CLUNY_RERANK=off

# Supervisor routing: llm (default, regex fallback) | regex
# CLUNY_SUPERVISOR=llm

# Local HTTP API (cluny serve)
# CLUNY_API_BIND=127.0.0.1
# CLUNY_API_PORT=8787
# CLUNY_API_TOKEN=

# Scheduled backups (cluny backup run)
# CLUNY_BACKUP_DIR=backups

# Per-document-type chunk sizes (used when CLI passes default 1200/200)
# CLUNY_CHUNK_PDF_SIZE=1500
# CLUNY_CHUNK_MD_SIZE=1200
# CLUNY_CHUNK_JOURNAL_SIZE=800
